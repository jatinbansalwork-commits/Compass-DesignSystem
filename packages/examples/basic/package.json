{
  "private": "true",
  "scripts": {
    "start": "DISABLE_ESLINT_PLUGIN=true react-scripts start",
    "build": "yarn build:klear360 && yarn build:app",
    "build:klear360": "cd ../../blade && yarn build",
    "build:app": "DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "analyze:only": "source-map-explorer 'build/static/js/*.js' --gzip",
    "analyze": "yarn build && yarn analyze:only",
    "postinstall": "rm -rf node_modules/@klearnow/klear360/node_modules"
  },
  "dependencies": {
    "@klearnow/klear360": "file:../../blade",
    "@fontsource/lato": "^4.5.10",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.9",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "5.3.5",
    "react-scripts": "^5.0.1",
    "@klearnow/i18nify-js": "1.4.4"
  },
  "devDependencies": {
    "source-map-explorer": "2.5.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
