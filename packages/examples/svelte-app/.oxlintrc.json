{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@klearnow/kdesign-svelte/configs/lint"],
  "rules": {
    "kdesign/no-conflicting-classes": "error",
    "kdesign/no-interpolated-classes": "error",
    "kdesign/no-unknown-kdesign-class": "error",
    "kdesign/prefer-token": "warn",
    "kdesign/no-restyle": "error"
  }
}
