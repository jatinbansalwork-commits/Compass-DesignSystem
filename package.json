{
  "private": true,
  "author": "kamleshchandnani",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=18.12.1"
  },
  "workspaces": {
    "packages": [
      "packages/kdesign",
      "packages/kdesign-core",
      "packages/eslint-plugin-kdesign",
      "packages/kdesign-mcp",
      "packages/kdesign-svelte",
      "packages/kdesign-plugin"
    ],
    "nohoist": [
      "@klearnow/kdesign/**"
    ]
  },
  "scripts": {
    "tsc:kdesign": "lerna run --scope @klearnow/kdesign typecheck",
    "tsc:knowledgebase": "node ./scripts/lintKnowledgebase.js",
    "check:knowledgebase-drift": "node ./scripts/checkKnowledgebaseDrift.js",
    "lint": "eslint --ext js,jsx,ts,tsx packages && stylelint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --ext js,jsx,ts,tsx packages --fix && stylelint '**/*.{js,jsx,ts,tsx}' --fix",
    "lint:kdesign": "eslint --ext js,jsx,ts,tsx packages/kdesign",
    "lint:kdesign-core": "eslint --ext js,jsx,ts,tsx packages/kdesign-core",
    "lint:kdesign-svelte": "eslint --ext js,ts packages/kdesign-svelte",
    "lint:kdesign-mcp": "NODE_OPTIONS=--max-old-space-size=8192 eslint --ext js,jsx,ts,tsx packages/kdesign-mcp",
    "lint:eslint-plugin": "eslint --ext js,jsx,ts,tsx packages/eslint-plugin-kdesign",
    "lint:stylelint": "stylelint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix:kdesign": "eslint --ext js,jsx,ts,tsx packages/kdesign --fix",
    "lint:fix:kdesign-core": "eslint --ext js,jsx,ts,tsx packages/kdesign-core --fix",
    "lint:fix:kdesign-svelte": "eslint --ext js,ts packages/kdesign-svelte --fix",
    "lint:fix:kdesign-mcp": "NODE_OPTIONS=--max-old-space-size=8192 eslint --ext js,jsx,ts,tsx packages/kdesign-mcp --fix",
    "lint:fix:eslint-plugin": "eslint --ext js,jsx,ts,tsx packages/eslint-plugin-kdesign --fix",
    "lint:fix:stylelint": "stylelint '**/*.{js,jsx,ts,tsx}' --fix",
    "publish-npm": "node ./scripts/publishToNpm.js",
    "version-packages": "changeset version && node ./scripts/syncPluginManifestVersion.js",
    "release": "node ./scripts/generateGitHubRegistryNpmrc.js && changeset publish",
    "postinstall": "yarn build:eslint-plugin-kdesign",
    "reinstall": "rm -rf packages/kdesign-core/node_modules packages/kdesign-svelte/node_modules && yarn install",
    "build": "npm-run-all --parallel build:*",
    "build:kdesign": "lerna run --scope @klearnow/kdesign build",
    "build:kdesign-core": "lerna run --scope @klearnow/kdesign-core build",
    "build:kdesign-mcp": "lerna run --scope @jatin_ux/kdesign-mcp build",
    "build:eslint-plugin-kdesign": "lerna run --scope eslint-plugin-kdesign build",
    "generate-docs-lockfile": "node packages/kdesign/scripts/generateDocsLockFile.mjs",
    "generate-icons": "node scripts/icons/generate.mjs",
    "fetch-icons": "node scripts/icons/fetch-from-figma.js",
    "aicodemod:serve": "node packages/kdesign/codemods/aicodemod/server.mjs",
    "aicodemod:host": "npx localtunnel --port 3000 --subdomain kdesign-ds",
    "ci:codesandbox": "yarn install --ignore-engines",
    "ci:codesandbox:install": "yarn install --ignore-engines --ignore-scripts",
    "ci:codesandbox:build": "yarn build:kdesign && yarn build:kdesign-core",
    "validate:kdesign-plugin": "node scripts/validateKdesignPlugin.mjs && node scripts/syncPluginManifestVersion.js --check && node --test packages/kdesign-plugin/tests/scripts.test.mjs packages/kdesign-plugin/hooks/__tests__/frameworks.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.21.8",
    "@babel/eslint-parser": "7.21.8",
    "@changesets/cli": "2.24.1",
    "@types/jest": "26.0.23",
    "@types/react": "18.2.24",
    "@typescript-eslint/eslint-plugin": "5.59.6",
    "@typescript-eslint/parser": "5.59.6",
    "@typescript-eslint/utils": "5.59.6",
    "chalk": "4.1.1",
    "eslint": "8.40.0",
    "eslint-config-kentcdodds": "18.0.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-kdesign": "1.0.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsdoc": "48.2.1",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-mdx": "2.1.0",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-native-a11y": "3.3.0",
    "eslint-plugin-storybook": "10.2.16",
    "execa": "5.1.0",
    "figures": "3.2.0",
    "glob": "10.4.5",
    "husky": "4.2.3",
    "lerna": "4.0.0",
    "lint-staged": "10.5.4",
    "lodash": "4.17.23",
    "node-plop": "0.32.0",
    "npm-run-all": "4.1.5",
    "nyc": "15.1.0",
    "prettier": "2.2.1",
    "shelljs": "0.8.5",
    "stylelint": "13.13.1",
    "stylelint-config-recommended": "5.0.0",
    "stylelint-config-styled-components": "0.1.1",
    "svgson": "5.3.1",
    "stylelint-processor-styled-components": "1.10.0",
    "ts-morph": "26.0.0",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "react-dom": "18.2.0",
    "react": "18.2.0",
    "@types/react": "18.2.24",
    "@types/styled-components": "5.1.34",
    "styled-components": "^5",
    "framer-motion": "11.12.0",
    "@octokit/rest": "21.0.2",
    "form-data": "^4.0.0",
    "fast-xml-parser": "^4.5.0",
    "shell-quote": "^1.8.2",
    "http-proxy-middleware": "2.0.10",
    "hono": "4.12.25",
    "vite": "6.4.4",
    "@hono/node-server": "1.19.13",
    "handlebars": "4.7.9",
    "yaml": "1.10.3",
    "trim": "0.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.(json|js|jsx|ts|tsx)": [
      "prettier --write"
    ]
  },
  "overrides": {
    "http-proxy-middleware": "2.0.10",
    "hono": "4.12.25",
    "vite": "6.4.4",
    "@hono/node-server": "1.19.13",
    "handlebars": "4.7.9",
    "yaml": "1.10.3",
    "trim": "0.0.3"
  }
}
